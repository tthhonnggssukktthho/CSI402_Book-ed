@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Book'ed Admin</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/colors.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_66014444_Project.styles.css" asp-append-version="true" />
</head>
<body class="admin-shell">
    <div class="admin-overlay" data-admin-overlay></div>

    <nav class="admin-topbar navbar fixed-top px-3 px-lg-4">
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn admin-icon-btn" data-admin-sidebar-toggle aria-label="Toggle sidebar">
                <span></span>
                <span></span>
                <span></span>
            </button>
            <a class="admin-brand text-decoration-none" asp-controller="Admin" asp-action="Dashboard">
                <span class="admin-brand-mark">A</span>
                <span class="admin-brand-text">
                    <strong>Book'ed</strong>
                    <small>Admin workspace</small>
                </span>
            </a>
        </div>

        <div class="d-flex align-items-center gap-2 gap-lg-3">
            <button type="button" class="btn admin-notify-btn position-relative">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M10 5a2 2 0 1 1 4 0a7 7 0 0 1 4 6v3a4 4 0 0 0 2 3H4a4 4 0 0 0 2-3v-3a7 7 0 0 1 4-6" />
                    <path d="M9 17v1a3 3 0 0 0 6 0v-1" />
                </svg>
                <span class="admin-notify-badge">3</span>
            </button>

            <div class="admin-profile">
                <div class="admin-avatar">AD</div>
                <div class="d-none d-sm-block">
                    <strong>@(User.Identity?.Name ?? "Admin")</strong>
                    <small>Administrator</small>
                </div>
            </div>
        </div>
    </nav>

    <aside class="admin-sidebar" data-admin-sidebar>
        <div class="admin-sidebar-header">
            <p class="mb-1 admin-sidebar-title">Admin Menu</p>
            <p class="mb-0 admin-sidebar-subtitle">จัดการผู้ใช้งาน ระบบร้าน และภาพรวมการดำเนินงาน</p>
        </div>

        <div class="admin-nav-section">
            <small class="admin-nav-caption">Management</small>
            <a class="admin-nav-link @(currentController == "Admin" && currentAction == "Dashboard" ? "active" : "")" asp-controller="Admin" asp-action="Dashboard">
                <span class="admin-nav-icon">D</span>
                <span>Dashboard</span>
            </a>
            <a class="admin-nav-link @(currentController == "Admin" && currentAction == "CustomerList" ? "active" : "")" asp-controller="Admin" asp-action="CustomerList">
                <span class="admin-nav-icon">C</span>
                <span>Customers</span>
            </a>
            <a class="admin-nav-link @(currentController == "Admin" && currentAction == "EmployeeList" ? "active" : "")" asp-controller="Admin" asp-action="EmployeeList">
                <span class="admin-nav-icon">E</span>
                <span>Employees</span>
            </a>
            <a class="admin-nav-link @(currentController == "Admin" && currentAction == "EmployeeCreate" ? "active" : "")" asp-controller="Admin" asp-action="EmployeeCreate">
                <span class="admin-nav-icon">+</span>
                <span>Create Employee</span>
            </a>
        </div>

        <div class="admin-nav-section">
            <small class="admin-nav-caption">Appraisal</small>
            <a class="admin-nav-link @(currentController == "Appraisal" && currentAction == "Queue" ? "active" : "")" asp-controller="Appraisal" asp-action="Queue">
                <span class="admin-nav-icon">P</span>
                <span>Appraisal Queue</span>
            </a>
            <a class="admin-nav-link @(currentController == "Appraisal" && currentAction == "Review" ? "active" : "")" asp-controller="Appraisal" asp-action="Review">
                <span class="admin-nav-icon">R</span>
                <span>Review Detail</span>
            </a>
        </div>

        <div class="admin-nav-section">
            <small class="admin-nav-caption">Finance</small>
            <a class="admin-nav-link @(currentController == "Finance" && currentAction == "Queue" ? "active" : "")" asp-controller="Finance" asp-action="Queue">
                <span class="admin-nav-icon">$</span>
                <span>Payment Queue</span>
            </a>
            <a class="admin-nav-link" asp-controller="Finance" asp-action="Queue">
                <span class="admin-nav-icon">T</span>
                <span>Transfer Review</span>
            </a>
            <a class="admin-nav-link" asp-controller="Finance" asp-action="Queue">
                <span class="admin-nav-icon">R</span>
                <span>Revenue Summary</span>
            </a>
        </div>

        <div class="admin-nav-section">
            <small class="admin-nav-caption">Shipping</small>
            <a class="admin-nav-link @(currentController == "Shipping" && currentAction == "Queue" ? "active" : "")" asp-controller="Shipping" asp-action="Queue">
                <span class="admin-nav-icon">S</span>
                <span>Shipping Queue</span>
            </a>
            <a class="admin-nav-link" asp-controller="Shipping" asp-action="Queue">
                <span class="admin-nav-icon">P</span>
                <span>Prepare Parcel</span>
            </a>
            <a class="admin-nav-link" asp-controller="Shipping" asp-action="Queue">
                <span class="admin-nav-icon">T</span>
                <span>Tracking Update</span>
            </a>
        </div>

        <div class="admin-nav-section">
            <small class="admin-nav-caption">Account</small>
            <a class="admin-nav-link" asp-controller="BookCatalog" asp-action="Index">
                <span class="admin-nav-icon">H</span>
                <span>Back to Shop</span>
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="admin-nav-link w-100 text-start border-0 bg-transparent">
                        <span class="admin-nav-icon">L</span>
                        <span>Log out</span>
                    </button>
                </form>
            }
        </div>

        <div class="admin-sidebar-card section-highlight">
            <p class="mb-1 fw-bold text-brown">Admin Focus</p>
            <p class="mb-0 small text-dark">ดูแลข้อมูลลูกค้า บัญชีพนักงาน และภาพรวมงานของทุกฝ่ายในระบบ</p>
        </div>
    </aside>

    <main class="admin-content">
        <div class="container-fluid px-3 px-lg-4">
            @RenderBody()

            <footer class="admin-footer">
                <p class="mb-0">Book'ed Admin Panel for internal management.</p>
            </footer>
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (() => {
            const sidebar = document.querySelector("[data-admin-sidebar]");
            const overlay = document.querySelector("[data-admin-overlay]");
            const toggleButtons = document.querySelectorAll("[data-admin-sidebar-toggle]");
            if (!sidebar || !overlay || !toggleButtons.length) {
                return;
            }

            const toggleSidebar = () => {
                document.body.classList.toggle("admin-sidebar-open");
            };

            toggleButtons.forEach(button => button.addEventListener("click", toggleSidebar));
            overlay.addEventListener("click", () => document.body.classList.remove("admin-sidebar-open"));
            window.addEventListener("resize", () => {
                if (window.innerWidth >= 992) {
                    document.body.classList.remove("admin-sidebar-open");
                }
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
