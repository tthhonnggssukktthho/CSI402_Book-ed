@{
    var activeCategory = (ViewData["ActiveCategory"] as string) ?? "All";
    var currentSearchType = (ViewData["SearchType"] as string) ?? "title";
    var currentSearchKeyword = (ViewData["SearchKeyword"] as string) ?? string.Empty;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isCustomer = User.IsInRole("customer");
    var customerName = isCustomer ? User.Identity?.Name : null;
    var categories = new[]
    {
        new { Key = "โรแมนซ์", Label = "โรแมนซ์" },
        new { Key = "สยองขวัญ", Label = "สยองขวัญ" },
        new { Key = "แฟนตาซี", Label = "แฟนตาซี" },
        new { Key = "วาย/ยูริ", Label = "วาย/ยูริ" },
        new { Key = "สืบสวน", Label = "สืบสวน" }
    };
}

<div class="store-navbar">
    <div class="store-navbar-top">
        <a class="store-brand" asp-controller="BookCatalog" asp-action="Index">
            <span class="store-brand-mark">B</span>
            <span>Book'ed</span>
        </a>

        <form asp-controller="BookCatalog" asp-action="Index" method="get" class="store-search" role="search">
            <label class="visually-hidden" for="searchType">Search type</label>
            <select id="searchType" name="searchType" class="store-search-type" aria-label="Search type">
                <option value="title" selected="@(currentSearchType == "title" ? "selected" : null)">ชื่อเรื่อง</option>
                <option value="author" selected="@(currentSearchType == "author" ? "selected" : null)">ผู้แต่ง</option>
                <option value="series" selected="@(currentSearchType == "series" ? "selected" : null)">ซีรีส์</option>
                <option value="isbn" selected="@(currentSearchType == "isbn" ? "selected" : null)">ISBN</option>
            </select>

            <label class="visually-hidden" for="searchInput">Search books</label>
            <input id="searchInput" name="searchKeyword" type="search" value="@currentSearchKeyword" class="store-search-input" placeholder="ค้นหาหนังสือที่อยากอ่านต่อ..." />

            @if (!string.Equals(activeCategory, "All", StringComparison.OrdinalIgnoreCase))
            {
                <input type="hidden" name="category" value="@activeCategory" />
            }

            <button type="submit" class="store-search-button">ค้นหา</button>
        </form>

        <div class="store-actions">
            

            @if (isCustomer)
            {
                <div class="dropdown">
                    <button class="store-pill-button store-pill-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        @customerName
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" asp-controller="Customer" asp-action="Profile">Profile</a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-controller="Customer" asp-action="MyBooks">MyBooks</a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-controller="Order" asp-action="Index">Orders</a>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger">Logout</button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            else if (isAuthenticated)
            {
                <a class="store-pill-button store-pill-secondary" asp-controller="Admin" asp-action="Dashboard">Welcome</a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="store-pill-button store-pill-secondary">ออกจากระบบ</button>
                </form>
            }
            else
            {
                <a class="store-pill-button store-pill-secondary" asp-controller="Account" asp-action="Login">เข้าบัญชี</a>
            }

            <a class="store-pill-button store-pill-primary" asp-controller="Cart" asp-action="CartIndex">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M7 6h14l-1.6 6.7a2 2 0 0 1-1.95 1.53H10a2 2 0 0 1-1.95-1.57L6.2 4H3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="10" cy="19" r="1.4" fill="currentColor" />
                    <circle cx="17" cy="19" r="1.4" fill="currentColor" />
                </svg>
            </a>
        </div>
    </div>

    <div class="store-category-row">
        <a class="store-category-link @(activeCategory == "All" ? "is-active" : string.Empty)" asp-controller="BookCatalog" asp-action="Index">ทั้งหมด</a>
        @foreach (var category in categories)
        {
            var isActive = activeCategory == category.Key;
            <a class="store-category-link @(isActive ? "is-active" : "")"
               asp-controller="BookCatalog"
               asp-action="Index"
               asp-route-category="@category.Key"
               asp-route-searchType="@currentSearchType"
               asp-route-searchKeyword="@currentSearchKeyword">@category.Label</a>
        }
    </div>

    <div id="storePromoCarousel" class="carousel slide store-carousel" data-bs-ride="carousel">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#storePromoCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#storePromoCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#storePromoCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>

        <div class="carousel-inner">
            <div class="carousel-item active">
                <div class="store-carousel-panel store-carousel-warm">
                    <div>
                        <p class="store-carousel-kicker">Curated Shelf</p>
                        <h2>คัดสรรหนังสือมือสองสภาพดี พร้อมขึ้นชั้นให้อ่านต่อ</h2>
                        <p>รวมเล่มน่าอ่านจากหลายหมวด ทั้งนิยายรัก แฟนตาซี และสืบสวน ในราคาที่หยิบง่ายและสภาพพร้อมใช้งาน</p>
                    </div>
                    <div class="store-carousel-stat">
                        <strong>300+</strong>
                        <span>Titles ready today</span>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <div class="store-carousel-panel store-carousel-cool">
                    <div>
                        <p class="store-carousel-kicker">Weekly Picks</p>
                        <h2>แฟนตาซีและสืบสวนมาแรงในสัปดาห์นี้</h2>
                        <p>รวมเล่มยอดนิยมที่ลูกค้าหยิบเข้าตะกร้าบ่อยที่สุด พร้อมโปรส่งฟรีเมื่อครบยอดที่กำหนด</p>
                    </div>
                    <div class="store-carousel-stat">
                        <strong>Free</strong>
                        <span>Shipping over 500 THB</span>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <div class="store-carousel-panel store-carousel-soft">
                    <div>
                        <p class="store-carousel-kicker">Collector Corner</p>
                        <h2>ตามหาเล่มหายาก หรือจัดชุดให้ครบก็เริ่มได้ที่นี่</h2>
                        <p>ค้นหาได้หลายแบบทั้งชื่อเรื่อง ผู้แต่ง ซีรีส์ และ ISBN เพื่อให้เจอหนังสือที่ต้องการได้เร็วขึ้น</p>
                    </div>
                    <div class="store-carousel-stat">
                        <strong>4 Ways</strong>
                        <span>To search your next book</span>
                    </div>
                </div>
            </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#storePromoCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#storePromoCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</div>
