@{
    var activeCategory = (ViewData["ActiveCategory"] as string) ?? "All";
    var categories = new[]
    {
        new { Key = "Romance", Label = "โรแมนซ์" },
        new { Key = "Horror", Label = "สยองขวัญ" },
        new { Key = "Fantasy", Label = "แฟนตาซี" },
        new { Key = "Y", Label = "วาย/ยูริ" },
        new { Key = "Mystery", Label = "สืบสวน" }
    };
}

<div class="store-navbar">
    <div class="store-navbar-top">
        <a class="store-brand" asp-controller="BookCatalog" asp-action="Index">
            <span class="store-brand-mark">B</span>
            <span>Book'ed</span>
        </a>

        <form class="store-search" role="search">
            <label class="visually-hidden" for="searchType">Search type</label>
            <select id="searchType" class="store-search-type" aria-label="Search type">
                <option>ชื่อเรื่อง</option>
                <option>ผู้แต่ง</option>
                <option>ซีรีส์</option>
                <option>ISBN</option>
            </select>

            <label class="visually-hidden" for="searchInput">Search books</label>
            <input id="searchInput" type="search" class="store-search-input" placeholder="ค้นหาหนังสือที่อยากอ่านต่อ..." />

            <button type="submit" class="store-search-button">ค้นหา</button>
        </form>

        <div class="store-actions">
            <button type="button" class="store-icon-button" aria-label="Notifications">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Zm7-4H5l1.6-1.8V11a5.4 5.4 0 0 1 4.4-5.3V5a1 1 0 1 1 2 0v.7A5.4 5.4 0 0 1 17.4 11v5.2L19 18Z" fill="currentColor" />
                </svg>
            </button>
            <a class="store-pill-button store-pill-secondary" asp-controller="Account" asp-action="Login">เข้าบัญชี</a>
            <a class="store-pill-button store-pill-primary" href="#">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M7 6h14l-1.6 6.7a2 2 0 0 1-1.95 1.53H10a2 2 0 0 1-1.95-1.57L6.2 4H3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="10" cy="19" r="1.4" fill="currentColor" />
                    <circle cx="17" cy="19" r="1.4" fill="currentColor" />
                </svg>
                <span>ตะกร้าสินค้า</span>
            </a>
        </div>
    </div>

    <div class="store-category-row">
        @foreach (var category in categories)
        {
            var isActive = activeCategory == category.Key;
            <a class="store-category-link @(isActive ? "is-active" : "")" href="#">@category.Label</a>
        }
    </div>

    <div id="storePromoCarousel" class="carousel slide store-carousel" data-bs-ride="carousel">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#storePromoCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#storePromoCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#storePromoCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>

        <div class="carousel-inner">
            <div class="carousel-item active">
                <div class="store-carousel-panel store-carousel-warm">
                    <div>
                        <p class="store-carousel-kicker">Curated Shelf</p>
                        <h2>หนังสือมือสองสภาพดี คัดแล้วพร้อมขึ้นชั้น</h2>
                        <p>รวมเล่มยอดนิยมที่พร้อมส่งต่อในราคาน่ารัก และยังคงมีคุณภาพสำหรับการอ่านรอบใหม่</p>
                    </div>
                    <div class="store-carousel-stat">
                        <strong>300+</strong>
                        <span>Titles ready today</span>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <div class="store-carousel-panel store-carousel-cool">
                    <div>
                        <p class="store-carousel-kicker">Weekly Picks</p>
                        <h2>แฟนตาซีและสืบสวน มาแรงในสัปดาห์นี้</h2>
                        <p>รวมเล่มน่าเก็บจากหลายหมวด พร้อมโปรส่งฟรีเมื่อครบยอดที่กำหนด</p>
                    </div>
                    <div class="store-carousel-stat">
                        <strong>Free</strong>
                        <span>Shipping over 500 THB</span>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <div class="store-carousel-panel store-carousel-soft">
                    <div>
                        <p class="store-carousel-kicker">Collector Corner</p>
                        <h2>ตามหาเล่มหายาก หรือจัดชุดให้ครบก็เริ่มได้ที่นี่</h2>
                        <p>ค้นหาได้หลายแบบทั้งชื่อเรื่อง ผู้แต่ง ซีรีส์ และ ISBN เพื่อให้เจอเล่มที่ต้องการเร็วขึ้น</p>
                    </div>
                    <div class="store-carousel-stat">
                        <strong>4 Ways</strong>
                        <span>To search your next book</span>
                    </div>
                </div>
            </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#storePromoCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#storePromoCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</div>
