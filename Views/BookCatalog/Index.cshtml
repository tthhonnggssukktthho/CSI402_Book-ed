@model _66014444_Project.ViewModels.BookCatalog.BookCatalogIndexViewModel
@{
    ViewData["Title"] = "Book Catalog";
}

<section class="catalog-page">
    <div class="catalog-heading">
        <div>
            <p class="catalog-kicker">Book Catalog</p>
            <h1>ชั้นหนังสือของร้าน Book'ed</h1>
            <p class="catalog-subtitle">รวมหนังสือมือสองที่ผ่านการอนุมัติและพร้อมวางขายในร้าน</p>
        </div>
        <div class="catalog-summary">
            <strong>@Model.TotalItems</strong>
            <span>สินค้าพร้อมขาย</span>
        </div>
    </div>

    <form asp-controller="BookCatalog" asp-action="Index" method="get" class="catalog-layout">
        <aside class="catalog-sidebar">
            <div class="filter-card">
                <h2>กรองสินค้า</h2>

                <input type="hidden" name="searchKeyword" value="@Model.SearchKeyword" />
                <input type="hidden" name="searchType" value="@Model.SearchType" />

                <div class="filter-group">
                    <span class="filter-label">หมวดหมู่</span>
                    <label><input type="radio" name="category" value="" checked="@(string.IsNullOrWhiteSpace(Model.FilterCategory) ? "checked" : null)" /> ทั้งหมด</label>
                    @foreach (var category in Model.Categories)
                    {
                        <label><input type="radio" name="category" value="@category" checked="@(string.Equals(Model.FilterCategory, category, StringComparison.OrdinalIgnoreCase) ? "checked" : null)" /> @category</label>
                    }
                </div>

                <div class="filter-group">
                    <span class="filter-label">สภาพหนังสือ</span>
                    <label><input type="radio" name="condition" value="" checked="@(string.IsNullOrWhiteSpace(Model.FilterCondition) ? "checked" : null)" /> ทั้งหมด</label>
                    <label><input type="radio" name="condition" value="LIKE_NEW" checked="@(Model.FilterCondition == "LIKE_NEW" ? "checked" : null)" /> เหมือนใหม่</label>
                    <label><input type="radio" name="condition" value="GOOD" checked="@(Model.FilterCondition == "GOOD" ? "checked" : null)" /> สภาพดี</label>
                    <label><input type="radio" name="condition" value="MINOR_DEFECT" checked="@(Model.FilterCondition == "MINOR_DEFECT" ? "checked" : null)" /> มีตำหนิเล็กน้อย</label>
                    <label><input type="radio" name="condition" value="MAJOR_DEFECT" checked="@(Model.FilterCondition == "MAJOR_DEFECT" ? "checked" : null)" /> มีตำหนิชัดเจน</label>
                </div>

                <div class="filter-group">
                    <span class="filter-label">ช่วงราคา</span>
                    <label><input type="radio" name="priceRange" value="" checked="@(string.IsNullOrWhiteSpace(Model.PriceRange) ? "checked" : null)" /> ทั้งหมด</label>
                    <label><input type="radio" name="priceRange" value="under_200" checked="@(Model.PriceRange == "under_200" ? "checked" : null)" /> ต่ำกว่า 200 บาท</label>
                    <label><input type="radio" name="priceRange" value="200_300" checked="@(Model.PriceRange == "200_300" ? "checked" : null)" /> 200 - 300 บาท</label>
                    <label><input type="radio" name="priceRange" value="over_300" checked="@(Model.PriceRange == "over_300" ? "checked" : null)" /> มากกว่า 300 บาท</label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="filter-apply-button">ใช้ตัวกรอง</button>
                    <a asp-controller="BookCatalog" asp-action="Index" class="btn btn-outline-secondary">ล้างตัวกรอง</a>
                </div>
            </div>
        </aside>

        <div class="catalog-content">
            <div class="catalog-toolbar">
                <p>แสดงผล @Model.Books.Count รายการ จากทั้งหมด @Model.TotalItems รายการ</p>
                <div class="catalog-toolbar-controls">
                    <label for="sortBy">เรียงตาม</label>
                    <select id="sortBy" name="sortBy" onchange="this.form.submit()">
                        <option value="recommended" selected="@(Model.SortBy == "recommended" ? "selected" : null)">แนะนำสำหรับคุณ</option>
                        <option value="price_asc" selected="@(Model.SortBy == "price_asc" ? "selected" : null)">ราคาต่ำไปสูง</option>
                        <option value="price_desc" selected="@(Model.SortBy == "price_desc" ? "selected" : null)">ราคาสูงไปต่ำ</option>
                        <option value="latest" selected="@(Model.SortBy == "latest" ? "selected" : null)">มาใหม่ล่าสุด</option>
                    </select>
                </div>
            </div>

            <div class="catalog-grid">
                @if (Model.Books.Count == 0)
                {
                    <div class="filter-card">
                        <h2>ยังไม่มีหนังสือที่อนุมัติแล้ว</h2>
                        <p class="mb-0 text-muted">เมื่อมีหนังสือผ่านการประเมินแล้ว รายการจะมาแสดงในหน้านี้อัตโนมัติ</p>
                    </div>
                }

                @foreach (var book in Model.Books)
                {
                    var coverTone = (book.CategoryName ?? string.Empty) switch
                    {
                        "โรแมนซ์" => "cover-romance",
                        "สยองขวัญ" => "cover-horror",
                        "แฟนตาซี" => "cover-fantasy",
                        "วาย/ยูริ" => "cover-y",
                        "สืบสวน" => "cover-mystery",
                        _ => "cover-romance"
                    };

                    @await Html.PartialAsync(
                        "_Bookcard",
                        new ViewDataDictionary(ViewData)
                        {
                            ["CoverTone"] = coverTone,
                            ["BookId"] = book.BookId,
                            ["Badge"] = book.ConditionCode,
                            ["Title"] = book.Title,
                            ["Author"] = book.AuthorName ?? "-",
                            ["Category"] = book.CategoryName ?? "-",
                            ["Price"] = book.FinalPrice.ToString("0.##"),
                            ["Detail"] = book.ConditionNote ?? "หนังสือผ่านการประเมินและพร้อมจำหน่าย"
                        })
                }
            </div>
        </div>
    </form>
</section>
