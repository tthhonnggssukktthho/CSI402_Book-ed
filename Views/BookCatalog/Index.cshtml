@model _66014444_Project.ViewModels.BookCatalog.BookCatalogIndexViewModel
@{
    ViewData["Title"] = "Book Catalog";
}

<section class="catalog-page">
    <div class="catalog-heading">
        <div>
            <p class="catalog-kicker">Book Catalog</p>
            <h1>ชั้นหนังสือของร้าน Book'ed</h1>
            <p class="catalog-subtitle">รวมหนังสือมือสองที่ผ่านการอนุมัติและพร้อมวางขายในร้าน</p>
        </div>
        <div class="catalog-summary">
            <strong>@Model.TotalItems</strong>
            <span>สินค้าพร้อมขาย</span>
        </div>
    </div>

    <div class="catalog-layout">
        <aside class="catalog-sidebar">
            <div class="filter-card">
                <h2>กรองสินค้า</h2>

                <div class="filter-group">
                    <span class="filter-label">หมวดหมู่</span>
                    <label><input type="checkbox" checked /> ทั้งหมด</label>
                    @foreach (var category in Model.Categories)
                    {
                        <label><input type="checkbox" /> @category</label>
                    }
                </div>

                <div class="filter-group">
                    <span class="filter-label">สภาพหนังสือ</span>
                    <label><input type="checkbox" checked /> เหมือนใหม่</label>
                    <label><input type="checkbox" /> สภาพดี</label>
                    <label><input type="checkbox" /> มีตำหนิเล็กน้อย</label>
                    <label><input type="checkbox" /> มีตำหนิชัดเจน</label>
                </div>

                <div class="filter-group">
                    <span class="filter-label">ช่วงราคา</span>
                    <label><input type="radio" name="priceRange" checked /> ทั้งหมด</label>
                    <label><input type="radio" name="priceRange" /> ต่ำกว่า 200 บาท</label>
                    <label><input type="radio" name="priceRange" /> 200 - 300 บาท</label>
                    <label><input type="radio" name="priceRange" /> มากกว่า 300 บาท</label>
                </div>

                <button type="button" class="filter-apply-button">ใช้ตัวกรอง</button>
            </div>
        </aside>

        <div class="catalog-content">
            <div class="catalog-toolbar">
                <p>แสดงผล @Model.Books.Count รายการ จากทั้งหมด @Model.TotalItems รายการ</p>
                <div class="catalog-toolbar-controls">
                    <label for="sortBy">เรียงตาม</label>
                    <select id="sortBy">
                        <option>แนะนำสำหรับคุณ</option>
                        <option>ราคาต่ำไปสูง</option>
                        <option>ราคาสูงไปต่ำ</option>
                        <option>มาใหม่ล่าสุด</option>
                    </select>
                </div>
            </div>

            <div class="catalog-grid">
                @if (Model.Books.Count == 0)
                {
                    <div class="filter-card">
                        <h2>ยังไม่มีหนังสือที่อนุมัติแล้ว</h2>
                        <p class="mb-0 text-muted">เมื่อมีหนังสือผ่านการประเมินแล้ว รายการจะมาแสดงในหน้านี้อัตโนมัติ</p>
                    </div>
                }

                @foreach (var book in Model.Books)
                {
                    var coverTone = (book.CategoryName ?? string.Empty) switch
                    {
                        "โรแมนซ์" => "cover-romance",
                        "สยองขวัญ" => "cover-horror",
                        "แฟนตาซี" => "cover-fantasy",
                        "วาย/ยูริ" => "cover-y",
                        "สืบสวน" => "cover-mystery",
                        _ => "cover-romance"
                    };

                    @await Html.PartialAsync(
                        "_Bookcard",
                        new ViewDataDictionary(ViewData)
                        {
                            ["CoverTone"] = coverTone,
                            ["BookId"] = book.BookId,
                            ["Badge"] = book.ConditionCode,
                            ["Title"] = book.Title,
                            ["Author"] = book.AuthorName ?? "-",
                            ["Category"] = book.CategoryName ?? "-",
                            ["Price"] = book.FinalPrice.ToString("0.##"),
                            ["Detail"] = book.ConditionNote ?? "หนังสือผ่านการประเมินและพร้อมจำหน่าย"
                        })
                }
            </div>
        </div>
    </div>
</section>
