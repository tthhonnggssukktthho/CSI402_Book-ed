@model _66014444_Project.ViewModels.BookCatalog.BookDetailViewModel
@{
    ViewData["Title"] = "Book Details";
    Layout = "_Layout";
}

<section class="catalog-page">
    <div class="catalog-heading">
        <div>
            <p class="catalog-kicker">Book Detail</p>
            <h1>@Model.Title</h1>
            <p class="catalog-subtitle">รายละเอียดหนังสือที่ผ่านการประเมินและพร้อมจำหน่ายในร้าน</p>
        </div>
        <div class="catalog-summary">
            <strong>฿@Model.FinalPrice.ToString("0.##")</strong>
            <span>ราคาขายสุทธิ</span>
        </div>
    </div>

    @if (TempData["CartSuccess"] is string cartMessage)
    {
        <div class="alert alert-success">@cartMessage</div>
    }

    <div class="catalog-layout">
        <aside class="catalog-sidebar">
            <div class="filter-card">
                <h2>ข้อมูลสรุป</h2>
                <div class="filter-group">
                    <span class="filter-label">หมวดหมู่</span>
                    <div>@Model.CategoryName</div>
                </div>
                <div class="filter-group">
                    <span class="filter-label">สภาพหนังสือ</span>
                    <div>@Model.ConditionCode</div>
                </div>
                <div class="filter-group">
                    <span class="filter-label">ส่วนลดตามสภาพ</span>
                    <div>@Model.ConditionDiscountPct.ToString("0.##")%</div>
                </div>
                <div class="filter-group">
                    <span class="filter-label">สถานะสินค้า</span>
                    <div class="text-capitalize">@Model.SaleStatus</div>
                </div>
            </div>
        </aside>

        <div class="catalog-content">
            <div class="filter-card mb-4">
                <div class="row g-4">
                    <div class="col-lg-5">
                        <div class="row g-3">
                            @foreach (var image in new[] { Model.ImageUrl, Model.ImageUrl2, Model.ImageUrl3, Model.ImageUrl4 }.Where(url => !string.IsNullOrWhiteSpace(url)))
                            {
                                <div class="col-6">
                                    <div class="border rounded-3 overflow-hidden bg-light h-100">
                                        <img src="@image" alt="@Model.Title" class="img-fluid w-100" style="height: 220px; object-fit: cover;" />
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-lg-7">
                        <div class="d-flex flex-column gap-3">
                            <div>
                                <p class="mb-1 text-muted">ชื่อหนังสือ</p>
                                <h2 class="mb-0">@Model.Title</h2>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <strong>ซีรีส์</strong>
                                    <div>@(string.IsNullOrWhiteSpace(Model.SeriesName) ? "-" : Model.SeriesName)</div>
                                </div>
                                <div class="col-md-6">
                                    <strong>เล่มที่</strong>
                                    <div>@(string.IsNullOrWhiteSpace(Model.VolumeNo) ? "-" : Model.VolumeNo)</div>
                                </div>
                                <div class="col-md-6">
                                    <strong>ผู้แต่ง</strong>
                                    <div>@(string.IsNullOrWhiteSpace(Model.AuthorName) ? "-" : Model.AuthorName)</div>
                                </div>
                                <div class="col-md-6">
                                    <strong>สำนักพิมพ์</strong>
                                    <div>@(string.IsNullOrWhiteSpace(Model.PublisherName) ? "-" : Model.PublisherName)</div>
                                </div>
                                <div class="col-md-6">
                                    <strong>ISBN</strong>
                                    <div>@(string.IsNullOrWhiteSpace(Model.Isbn) ? "-" : Model.Isbn)</div>
                                </div>
                                <div class="col-md-6">
                                    <strong>ปีที่พิมพ์</strong>
                                    <div>@(Model.PublishYear?.ToString() ?? "-")</div>
                                </div>
                            </div>

                            <div>
                                <strong>เรื่องย่อ</strong>
                                <p class="mb-0">@(string.IsNullOrWhiteSpace(Model.Synopsis) ? "-" : Model.Synopsis)</p>
                            </div>

                            <div>
                                <strong>รายละเอียดหนังสือ</strong>
                                <p class="mb-0">@(string.IsNullOrWhiteSpace(Model.BookDescription) ? "-" : Model.BookDescription)</p>
                            </div>

                            <div>
                                <strong>หมายเหตุสภาพ</strong>
                                <p class="mb-0">@(string.IsNullOrWhiteSpace(Model.ConditionNote) ? "-" : Model.ConditionNote)</p>
                            </div>

                            <div class="d-flex flex-wrap align-items-end gap-4 pt-2">
                                <div>
                                    <div class="text-muted small">ราคาหลังประเมิน</div>
                                    <div class="fs-3 fw-bold text-brown">฿@Model.FinalPrice.ToString("0.##")</div>
                                    <div class="small text-muted">ราคาประเมิน ฿@Model.ApprovedPrice.ToString("0.##")</div>
                                </div>

                                @if (Model.CanAddToCart)
                                {
                                    <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="bookId" value="@Model.BookId" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="book-card-button">
                                            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="9" cy="20" r="1"></circle>
                                                <circle cx="18" cy="20" r="1"></circle>
                                                <path d="M2 3h3l2.4 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 7H6"></path>
                                            </svg>
                                            <span class="ms-2">เพิ่มเข้ารถเข็น</span>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" class="book-card-button" disabled>ไม่พร้อมจำหน่าย</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
