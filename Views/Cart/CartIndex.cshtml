@model _66014444_Project.ViewModels.Cart.CartViewModel
@{
    ViewData["Title"] = "ตะกร้าสินค้า";
    Layout = "_Layout";
}

<section class="catalog-page">
    <div class="catalog-heading">
        <div>
            <p class="catalog-kicker">Cart</p>
            <h1>ตะกร้าสินค้าของฉัน</h1>
            <p class="catalog-subtitle">ตรวจสอบรายการหนังสือที่คุณเลือกไว้ก่อนดำเนินการสั่งซื้อ</p>
        </div>
        <div class="catalog-summary">
            <strong>@Model.Items.Count</strong>
            <span>รายการในตะกร้า</span>
        </div>
    </div>

    @if (TempData["CartSuccess"] is string cartMessage)
    {
        <div class="alert alert-success">@cartMessage</div>
    }

    <div class="filter-card">
        @if (Model.IsEmpty)
        {
            <h2>ตะกร้าของคุณยังว่างอยู่</h2>
            <p class="mb-3 text-muted">ลองเลือกหนังสือจากหน้าแคตตาล็อกแล้วเพิ่มเข้าตะกร้าได้เลย</p>
            <a asp-controller="BookCatalog" asp-action="Index" class="book-card-button">ไปเลือกหนังสือ</a>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-4">
                    <thead>
                        <tr>
                            <th>หนังสือ</th>
                            <th>สภาพ</th>
                            <th>ราคา</th>
                            <th>การจัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="border rounded-3 overflow-hidden bg-light" style="width: 72px; height: 96px;">
                                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" alt="@item.Title" class="img-fluid w-100 h-100" style="object-fit: cover;" />
                                            }
                                        </div>
                                        <div>
                                            <div class="fw-semibold">@item.Title</div>
                                            <div class="text-muted small">@item.SeriesName @(!string.IsNullOrWhiteSpace(item.VolumeNo) ? $"เล่ม {item.VolumeNo}" : string.Empty)</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@item.ConditionCode</td>
                                <td>฿@item.FinalPrice.ToString("0.##")</td>
                                <td>
                                    <div class="d-flex gap-2 flex-wrap">
                                        <a asp-controller="BookCatalog" asp-action="Detail" asp-route-id="@item.BookId" class="btn btn-outline-primary btn-sm">รายละเอียด</a>
                                        <form asp-controller="Cart" asp-action="RemoveFromCart" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="itemId" value="@item.CartItemId" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">ลบ</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <a asp-controller="BookCatalog" asp-action="Index" class="btn btn-outline-secondary">เลือกหนังสือเพิ่ม</a>
                <div class="text-end">
                    <div class="text-muted small">ยอดรวม</div>
                    <div class="fs-4 fw-bold text-brown">฿@Model.Subtotal.ToString("0.##")</div>
                </div>
            </div>
            <div>
                <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary btn-lg w-100">ดำเนินการสั่งซื้อ</a>
            </div>
        }
    </div>
</section>
