@model _66014444_Project.ViewModels.Appraisal.AppraisalReviewViewModel
@{
    ViewData["Title"] = "Appraisal Review";
    Layout = "_LayoutStaff";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-xl-11">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-lg-5">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
                        <div>
                            <h2 class="mb-1">ตรวจสอบและประเมินหนังสือ</h2>
                            <p class="text-muted mb-0">ตรวจรายละเอียดหนังสือ แก้ไขข้อมูลที่จำเป็น และบันทึกผลการประเมิน</p>
                        </div>
                        <a asp-action="Queue" asp-controller="Appraisal" class="btn btn-outline-secondary">กลับไปหน้าคิวประเมิน</a>
                    </div>

                    @if (TempData["AppraisalSuccess"] is string successMessage)
                    {
                        <div class="alert alert-success">@successMessage</div>
                    }

                    <form asp-action="Review" asp-controller="Appraisal" method="post" class="row g-3" id="appraisal-review-form">
                        @Html.AntiForgeryToken()
                        <input asp-for="BookId" type="hidden" />
                        <input type="hidden" name="submitAction" id="submitAction" value="save" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="col-12">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <div class="border rounded-3 p-3 h-100 bg-light">
                                        <small class="text-muted d-block">สถานะประเมิน</small>
                                        <strong class="text-capitalize">@Model.ApprovalStatus</strong>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="border rounded-3 p-3 h-100 bg-light">
                                        <small class="text-muted d-block">สถานะการขาย</small>
                                        <strong class="text-capitalize">@Model.SaleStatus</strong>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="border rounded-3 p-3 h-100 bg-light">
                                        <small class="text-muted d-block">ผู้ขาย</small>
                                        <strong>@Model.SellerDisplayName</strong>
                                        <div class="small text-muted">@Model.SellerUsername</div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="border rounded-3 p-3 h-100 bg-light">
                                        <small class="text-muted d-block">ผู้ประเมินล่าสุด</small>
                                        <strong>@(Model.ReviewedByName ?? "-")</strong>
                                        <div class="small text-muted">@(Model.ReviewedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <hr class="my-2" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Title" class="form-label"></label><span class="text-danger ms-1">*</span>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="SeriesName" class="form-label"></label>
                            <input asp-for="SeriesName" class="form-control" />
                            <span asp-validation-for="SeriesName" class="text-danger"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="VolumeNo" class="form-label"></label>
                            <input asp-for="VolumeNo" class="form-control" />
                            <span asp-validation-for="VolumeNo" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CategoryName" class="form-label"></label><span class="text-danger ms-1">*</span>
                            <select asp-for="CategoryName" class="form-select">
                                <option value="">เลือกหมวดหมู่</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category">@category</option>
                                }
                            </select>
                            <span asp-validation-for="CategoryName" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="PublisherName" class="form-label"></label>
                            <input asp-for="PublisherName" class="form-control" />
                            <span asp-validation-for="PublisherName" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="AuthorName" class="form-label"></label>
                            <input asp-for="AuthorName" class="form-control" />
                            <span asp-validation-for="AuthorName" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Isbn" class="form-label"></label>
                            <input asp-for="Isbn" class="form-control" />
                            <span asp-validation-for="Isbn" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="PublishYear" class="form-label"></label>
                            <input asp-for="PublishYear" class="form-control" />
                            <span asp-validation-for="PublishYear" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ConditionCode" class="form-label"></label><span class="text-danger ms-1">*</span>
                            <select asp-for="ConditionCode" class="form-select">
                                <option value="">เลือกระดับสภาพ</option>
                                @foreach (var option in Model.ConditionOptions)
                                {
                                    <option value="@option.Value">@option.Text</option>
                                }
                            </select>
                            <span asp-validation-for="ConditionCode" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ProposedPrice" class="form-label"></label>
                            <input asp-for="ProposedPrice" class="form-control" />
                            <span asp-validation-for="ProposedPrice" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ApprovedPrice" class="form-label"></label><span class="text-danger ms-1">*</span>
                            <input asp-for="ApprovedPrice" class="form-control" />
                            <span asp-validation-for="ApprovedPrice" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Synopsis" class="form-label"></label>
                            <textarea asp-for="Synopsis" class="form-control" rows="5"></textarea>
                            <span asp-validation-for="Synopsis" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="BookDescription" class="form-label"></label>
                            <textarea asp-for="BookDescription" class="form-control" rows="5"></textarea>
                            <span asp-validation-for="BookDescription" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="ConditionNote" class="form-label"></label>
                            <textarea asp-for="ConditionNote" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="ConditionNote" class="text-danger"></span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
                        {
                            <div class="col-12">
                                <div class="alert alert-warning mb-0">
                                    <strong>เหตุผลที่เคยไม่อนุมัติ:</strong> @Model.RejectionReason
                                </div>
                            </div>
                        }

                        <div class="col-12">
                            <label class="form-label">รูปภาพประกอบ</label>
                            <div class="row g-3">
                                @foreach (var image in new[] { Model.ImageUrl, Model.ImageUrl2, Model.ImageUrl3, Model.ImageUrl4 }.Where(url => !string.IsNullOrWhiteSpace(url)))
                                {
                                    <div class="col-sm-6 col-lg-3">
                                        <div class="border rounded-3 overflow-hidden bg-light h-100">
                                            <img src="@image" alt="Book image" class="img-fluid w-100" style="height: 220px; object-fit: cover;" />
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-12 pt-2 d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-primary" onclick="document.getElementById('submitAction').value='save';">บันทึกการแก้ไข</button>
                            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#approveModal">อนุมัติ</button>
                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">ไม่อนุมัติ</button>
                        </div>

                        <div class="modal fade" id="approveModal" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">ยืนยันการอนุมัติ</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        คุณแน่ใจหรือไม่ว่าต้องการอนุมัติหนังสือรายการนี้
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                                        <button type="submit" class="btn btn-success" onclick="document.getElementById('submitAction').value='approve';">ยืนยันการอนุมัติ</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">ไม่อนุมัติรายการหนังสือ</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <label asp-for="RejectionReason" class="form-label"></label><span class="text-danger ms-1">*</span>
                                        <textarea asp-for="RejectionReason" class="form-control" rows="4" placeholder="ระบุเหตุผลที่ไม่อนุมัติ"></textarea>
                                        <span asp-validation-for="RejectionReason" class="text-danger"></span>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                                        <button type="submit" class="btn btn-danger" onclick="document.getElementById('submitAction').value='reject';">ยืนยันการไม่อนุมัติ</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
