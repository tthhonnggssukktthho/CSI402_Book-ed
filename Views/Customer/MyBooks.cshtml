@model _66014444_Project.ViewModels.Customer.MyBooksViewModel
@{
    ViewData["Title"] = "หนังสือของฉัน";
    Layout = "_Layout";
}

<section class="customer-books-page py-4 py-lg-5">
    <div class="customer-books-hero mb-4">
        <div>
            <p class="customer-books-kicker">My Books</p>
            <h1 class="customer-books-title">คลังหนังสือของฉัน</h1>
            <p class="customer-books-subtitle">สลับดูได้ทั้งหนังสือที่คุณซื้อแล้ว และหนังสือที่คุณส่งเข้ามาขาย โดยไม่ต้องเปลี่ยนหน้า</p>
        </div>
    </div>

    @if (TempData["SellBookSuccess"] is string successMessage)
    {
        <div class="alert alert-success mb-4">@successMessage</div>
    }

    <div class="customer-books-switcher mb-4" role="tablist" aria-label="Book views">
        <button type="button" class="customer-books-tab is-active" data-books-tab="purchased" aria-selected="true">
            แสดงหนังสือที่ซื้อแล้ว
        </button>
        <button type="button" class="customer-books-tab" data-books-tab="selling" aria-selected="false">
            แสดงหนังสือที่ยื่นขาย
        </button>
    </div>

    <div class="customer-books-panel is-active" data-books-panel="purchased">
        <div class="customer-books-panel-head">
            <div>
                <h2>หนังสือที่ซื้อแล้ว</h2>
                <p>ตัวอย่างโครงหน้าสำหรับแสดงรายการหนังสือที่ลูกค้าซื้อเรียบร้อยแล้ว</p>
            </div>
        </div>

        <div class="row g-4">
            <aside class="col-lg-3">
                <div class="customer-books-filter">
                    <h3>ตัวกรอง</h3>
                    <label><input type="checkbox" checked /> ซื้อภายใน 30 วัน</label>
                    <label><input type="checkbox" /> พร้อมอ่านต่อ</label>
                    <label><input type="checkbox" /> มีรีวิวจากร้าน</label>
                </div>
            </aside>

            <div class="col-lg-9">
                <div class="customer-books-grid">
                    <article class="customer-book-card">
                        <div class="customer-book-cover customer-book-cover-purchased">ซื้อแล้ว</div>
                        <div class="customer-book-body">
                            <p class="customer-book-type">Purchased</p>
                            <h3>เกิดใหม่อีกครั้ง ฉันก็ยังเป็นเจ้าหญิง</h3>
                            <p>ผู้แต่ง: Example Author</p>
                            <p>วันที่ซื้อ: 2026-03-18</p>
                            <a href="#" class="customer-book-link">ดูรายละเอียด</a>
                        </div>
                    </article>

                    <article class="customer-book-card">
                        <div class="customer-book-cover customer-book-cover-purchased">ซื้อแล้ว</div>
                        <div class="customer-book-body">
                            <p class="customer-book-type">Purchased</p>
                            <h3>แฟ้มคดีห้องสมุดปิดตาย</h3>
                            <p>ผู้แต่ง: Mystery Writer</p>
                            <p>วันที่ซื้อ: 2026-02-28</p>
                            <a href="#" class="customer-book-link">ดูรายละเอียด</a>
                        </div>
                    </article>

                    <article class="customer-book-card">
                        <div class="customer-book-cover customer-book-cover-purchased">ซื้อแล้ว</div>
                        <div class="customer-book-body">
                            <p class="customer-book-type">Purchased</p>
                            <h3>บทกวีใต้แสงจันทร์</h3>
                            <p>ผู้แต่ง: Moonlight Press</p>
                            <p>วันที่ซื้อ: 2026-01-09</p>
                            <a href="#" class="customer-book-link">ดูรายละเอียด</a>
                        </div>
                    </article>
                </div>
            </div>
        </div>
    </div>

    <div class="customer-books-panel" data-books-panel="selling" hidden>
        <div class="customer-books-panel-head">
            <div>
                <h2>หนังสือที่ยื่นขาย</h2>
                <p>รายการจริงของหนังสือที่คุณส่งเข้ามาให้ร้านประเมินและขายต่อ</p>
            </div>
            <a asp-controller="SellBook" asp-action="Create" class="customer-books-create-btn">
                ไปหน้าลงข้อมูลขายหนังสือ
            </a>
        </div>

        <div class="row g-4">
            <aside class="col-lg-3">
                <div class="customer-books-filter">
                    <h3>ตัวกรอง</h3>
                    <label><input type="checkbox" checked /> รอประเมิน</label>
                    <label><input type="checkbox" /> อนุมัติแล้ว</label>
                    <label><input type="checkbox" /> ขายสำเร็จ</label>
                </div>
            </aside>

            <div class="col-lg-9">
                @if (Model.SellingBooks.Any())
                {
                    <div class="customer-books-grid">
                        @foreach (var book in Model.SellingBooks)
                        {
                            <article class="customer-book-card">
                                <div class="customer-book-cover customer-book-cover-selling" style="background-image: linear-gradient(135deg, rgba(226,155,95,.85), rgba(255,228,149,.85)), url('@book.ImageUrl'); background-size: cover; background-position: center;">
                                    <span>@book.ApprovalStatus</span>
                                </div>
                                <div class="customer-book-body">
                                    <p class="customer-book-type">Sell Submission</p>
                                    <h3>@book.Title</h3>
                                    <p>ซีรีส์: @(string.IsNullOrWhiteSpace(book.SeriesName) ? "-" : book.SeriesName)</p>
                                    <p>เล่ม: @(string.IsNullOrWhiteSpace(book.VolumeNo) ? "-" : book.VolumeNo)</p>
                                    <p>ราคาที่ยื่น: @(book.ProposedPrice.HasValue ? $"฿{book.ProposedPrice.Value:N2}" : "-")</p>
                                    <p>ราคาที่อนุมัติ: @(book.ApprovedPrice.HasValue ? $"฿{book.ApprovedPrice.Value:N2}" : "-")</p>
                                    <p>สภาพ: @book.ConditionCode</p>
                                    <p>สถานะประเมิน: @book.ApprovalStatus</p>
                                    <p>สถานะการขาย: @book.SaleStatus</p>
                                    <p>วันที่ส่งขาย: @book.CreatedAt.ToString("yyyy-MM-dd")</p>
                                    @if (!string.IsNullOrWhiteSpace(book.ConditionNote))
                                    {
                                        <p>หมายเหตุ: @book.ConditionNote</p>
                                    }
                                    @if (book.CanEdit)
                                    {
                                        <a asp-controller="SellBook" asp-action="Edit" asp-route-id="@book.BookId" class="customer-book-link">แก้ไขข้อมูล</a>
                                    }
                                    else
                                    {
                                        <span class="customer-book-link text-muted">ไม่สามารถแก้ไขได้แล้ว</span>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="customer-books-empty">
                        <h3>ยังไม่มีหนังสือที่ยื่นขาย</h3>
                        <p>เริ่มลงข้อมูลหนังสือเล่มแรกของคุณได้จากปุ่มด้านบน</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tabs = document.querySelectorAll("[data-books-tab]");
            const panels = document.querySelectorAll("[data-books-panel]");

            tabs.forEach((tab) => {
                tab.addEventListener("click", function () {
                    const target = tab.getAttribute("data-books-tab");

                    tabs.forEach((item) => {
                        const isActive = item === tab;
                        item.classList.toggle("is-active", isActive);
                        item.setAttribute("aria-selected", isActive ? "true" : "false");
                    });

                    panels.forEach((panel) => {
                        const isActive = panel.getAttribute("data-books-panel") === target;
                        panel.classList.toggle("is-active", isActive);
                        panel.hidden = !isActive;
                    });
                });
            });
        });
    </script>
}
