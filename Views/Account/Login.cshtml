@{
    ViewData["Title"] = "Login";
    Layout = "_BlankLayout";
}
@model _66014444_Project.ViewModels.LoginViewModel

<section class="auth-panel auth-panel-login">
    <div class="auth-panel-copy">
        <a class="auth-brand" asp-controller="BookCatalog" asp-action="Index">Book'ed</a>
        <p class="auth-eyebrow">Welcome Back</p>
        <h1>กลับเข้าสู่ชั้นหนังสือของคุณ แล้วไปต่อกับเล่มที่กำลังตามหา</h1>
        <p class="auth-description">
            เข้าสู่ระบบเพื่อดูคำสั่งซื้อ รายการหนังสือที่บันทึกไว้ และจัดการบัญชีของคุณในพื้นที่ที่เรียบง่ายสบายตา
        </p>

        <div class="auth-copy-card">
            <span>Your Next Chapter</span>
            <p>ติดตามหนังสือที่สนใจ เช็กสถานะคำสั่งซื้อ และกลับมาเลือกเล่มใหม่ได้จากบัญชีเดิมของคุณ</p>
        </div>
    </div>

    <div class="auth-form-card auth-form-card-login">
        <div class="auth-form-header">
            <p class="auth-form-kicker">Sign In</p>
            <h2>เข้าสู่ระบบ</h2>
        </div>

        <form class="auth-form-grid auth-form-grid-single">
            <div class="auth-field">
                <label for="email">Email</label>
                <input asp-for="Email" type="email" class="form-control auth-input" id="email" placeholder="name@example.com">
            </div>

            <div class="auth-field">
                <label for="password">Password</label>
                <input asp-for="Password" type="password" class="form-control auth-input" id="password" placeholder="กรอกรหัสผ่าน">
            </div>

            <label class="auth-check-row" for="rememberMe">
                <input type="checkbox" id="rememberMe">
                <span>จดจำการเข้าสู่ระบบ</span>
            </label>

            <button type="submit" class="auth-submit-button">เข้าสู่ระบบ</button>
            <a class="auth-secondary-link" asp-controller="Account" asp-action="Register">ยังไม่มีบัญชี? สมัครสมาชิก</a>
        </form>
    </div>
</section>
