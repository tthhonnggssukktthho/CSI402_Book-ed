@model _66014444_Project.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_BlankLayout";
}

<section class="auth-panel auth-panel-login">
    <div class="auth-panel-copy">
        <a class="auth-brand" asp-controller="BookCatalog" asp-action="Index">Book'ed</a>
        <p class="auth-eyebrow">Welcome Back</p>
        <h1>Sign in and continue your next chapter.</h1>
        <p class="auth-description">
            Customers will be redirected to the catalog. Staff accounts will go straight to the operations.
        </p>

        <div class="auth-copy-card">
            <span>One account, the right destination</span>
            <p>Customer, admin, appraisal, finance and shipping accounts all use the same login form, then the system routes each role to the correct page automatically.</p>
        </div>
    </div>

    <div class="auth-form-card auth-form-card-login">
        <div class="auth-form-header">
            <p class="auth-form-kicker">Sign In</p>
            <h2>Login to your account</h2>
        </div>

        <form asp-action="Login" asp-controller="Account" method="post" class="auth-form-grid auth-form-grid-single">
            @Html.AntiForgeryToken()
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="auth-field">
                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" class="form-control auth-input" placeholder="name@example.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Password"></label>
                <input asp-for="Password" type="password" class="form-control auth-input" placeholder="Enter your password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <label class="auth-check-row" asp-for="RememberMe">
                <input asp-for="RememberMe" />
                <span>Remember me</span>
            </label>

            <button type="submit" class="auth-submit-button">Sign In</button>
            <a class="auth-secondary-link" asp-controller="Account" asp-action="Register">ยังไม่มีบัญชี? สมัครสมาชิก</a>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
