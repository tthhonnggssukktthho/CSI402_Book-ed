@model _66014444_Project.ViewModels.RegisterViewModel
@{
    Layout = "~/Views/Shared/_BlankLayout.cshtml";
    ViewData["Title"] = "Register";
}

<section class="auth-panel register-panel">
    <div class="auth-panel-copy">
        <a class="auth-brand" asp-controller="BookCatalog" asp-action="Index">Book'ed</a>
        <p class="auth-eyebrow">Join The Shelf</p>
        <h1>Create a new account and start building your own reading corner.</h1>
        <p class="auth-description">
            Register as a customer to keep track of your account, save your profile information,
            and continue with the rest of the bookstore flow.
        </p>

        <div class="auth-copy-card">
            <span>Why Book'ed</span>
            <p>Your registration data will now be saved to the database and shown in the customer list for admin management.</p>
        </div>
    </div>

    <div class="auth-form-card">
        <div class="auth-form-header">
            <p class="auth-form-kicker">Create Account</p>
            <h2>Register</h2>
        </div>

        <form asp-action="Register" asp-controller="Account" method="post" class="auth-form-grid">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="auth-field">
                <label asp-for="Username"></label>
                <input asp-for="Username" class="form-control auth-input" placeholder="Choose a username" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control auth-input" placeholder="name@example.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control auth-input" placeholder="At least 6 characters" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="auth-field">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="form-control auth-input" placeholder="Confirm your password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="auth-field">
                <label asp-for="DisplayName"></label>
                <input asp-for="DisplayName" class="form-control auth-input" placeholder="Display name in the system" />
                <span asp-validation-for="DisplayName" class="text-danger"></span>
            </div>

            <div class="auth-field">
                <label asp-for="PhoneNumber"></label>
                <input asp-for="PhoneNumber" class="form-control auth-input" placeholder="08x-xxx-xxxx" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <button type="submit" class="auth-submit-button">Create Account</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
