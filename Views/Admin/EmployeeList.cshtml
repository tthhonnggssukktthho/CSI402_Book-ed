@model _66014444_Project.ViewModels.Admin.AdminEmployeeListViewModel
@{
    ViewData["Title"] = "Employee List";
    Layout = "_LayoutStaff";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Employee List</h2>
            <p class="text-muted mb-0">All employee accounts currently stored in the system.</p>
        </div>
        <a asp-action="EmployeeCreate" asp-controller="Admin" class="btn btn-primary">Add Employee</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Employee Code</th>
                            <th>Full Name</th>
                            <th>Role</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Phone Number</th>
                            <th>Hire Date</th>
                            <th>Status</th>
                            <th>Created At</th>
                            <th>Updated At</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var employee in Model.Employees)
                        {
                            <tr>
                                <td>@employee.EmployeeCode</td>
                                <td>@employee.FullName</td>
                                <td class="text-capitalize">@employee.Role</td>
                                <td>@employee.Username</td>
                                <td>@employee.Email</td>
                                <td>@employee.PhoneNumber</td>
                                <td>@employee.HireDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-capitalize">@employee.EmploymentStatus</td>
                                <td>@employee.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td>@employee.UpdatedAt.ToString("yyyy-MM-dd")</td>
                                <td class="text-nowrap">
                                    <a asp-action="EmployeeEdit" asp-controller="Admin" asp-route-id="@employee.EmployeeId" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <button type="button" class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#employeeDetailModal-@employee.EmployeeId">Detail</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@foreach (var employee in Model.Employees)
{
    <div class="modal fade" id="employeeDetailModal-@employee.EmployeeId" tabindex="-1" aria-labelledby="employeeDetailModalLabel-@employee.EmployeeId" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title" id="employeeDetailModalLabel-@employee.EmployeeId">Employee Detail</h5>
                        <small class="text-muted">@employee.EmployeeCode</small>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <strong>Full Name</strong>
                            <div>@employee.FullName</div>
                        </div>
                        <div class="col-md-6">
                            <strong>Role</strong>
                            <div class="text-capitalize">@employee.Role</div>
                        </div>
                        <div class="col-md-6">
                            <strong>Username</strong>
                            <div>@employee.Username</div>
                        </div>
                        <div class="col-md-6">
                            <strong>Email</strong>
                            <div>@employee.Email</div>
                        </div>
                        <div class="col-md-6">
                            <strong>Phone Number</strong>
                            <div>@(string.IsNullOrWhiteSpace(employee.PhoneNumber) ? "-" : employee.PhoneNumber)</div>
                        </div>
                        <div class="col-md-6">
                            <strong>Status</strong>
                            <div class="text-capitalize">@employee.EmploymentStatus</div>
                        </div>
                        <div class="col-md-6">
                            <strong>Hire Date</strong>
                            <div>@employee.HireDate.ToString("yyyy-MM-dd")</div>
                        </div>
                        <div class="col-md-6">
                            <strong>Resign Date</strong>
                            <div>@(employee.ResignDate?.ToString("yyyy-MM-dd") ?? "-")</div>
                        </div>
                        <div class="col-12">
                            <strong>Address Line 1</strong>
                            <div>@(string.IsNullOrWhiteSpace(employee.Address1) ? "-" : employee.Address1)</div>
                        </div>
                        <div class="col-12">
                            <strong>Address Line 2</strong>
                            <div>@(string.IsNullOrWhiteSpace(employee.Address2) ? "-" : employee.Address2)</div>
                        </div>
                        <div class="col-md-3">
                            <strong>Subdistrict</strong>
                            <div>@(string.IsNullOrWhiteSpace(employee.Subdistrict) ? "-" : employee.Subdistrict)</div>
                        </div>
                        <div class="col-md-3">
                            <strong>District</strong>
                            <div>@(string.IsNullOrWhiteSpace(employee.District) ? "-" : employee.District)</div>
                        </div>
                        <div class="col-md-3">
                            <strong>Province</strong>
                            <div>@(string.IsNullOrWhiteSpace(employee.Province) ? "-" : employee.Province)</div>
                        </div>
                        <div class="col-md-3">
                            <strong>Postal Code</strong>
                            <div>@(string.IsNullOrWhiteSpace(employee.PostalCode) ? "-" : employee.PostalCode)</div>
                        </div>
                        <div class="col-md-6">
                            <strong>Created At</strong>
                            <div>@employee.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                        </div>
                        <div class="col-md-6">
                            <strong>Updated At</strong>
                            <div>@employee.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <a asp-action="EmployeeEdit" asp-controller="Admin" asp-route-id="@employee.EmployeeId" class="btn btn-primary">Edit This Employee</a>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}
