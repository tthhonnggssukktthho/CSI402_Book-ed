@model _66014444_Project.ViewModels.Admin.AdminEmployeeFormViewModel
@{
    ViewData["Title"] = "Employee Edit";
    Layout = "_LayoutStaff";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-lg-5">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="mb-1">Edit Employee Account</h2>
                            <p class="text-muted mb-0">Update account, profile, address and employment information.</p>
                        </div>
                        <a asp-action="EmployeeList" asp-controller="Admin" class="btn btn-outline-secondary">Back to List</a>
                    </div>

                    <form asp-action="EmployeeEdit" asp-controller="Admin" method="post" class="row g-3">
                        @Html.AntiForgeryToken()
                        <input asp-for="EmployeeId" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="col-md-6">
                            <label asp-for="EmployeeCode" class="form-label"></label>
                            <input asp-for="EmployeeCode" class="form-control" readonly />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label"></label>
                            <select asp-for="Role" class="form-select">
                                <option value="">Select role</option>
                                @foreach (var role in _66014444_Project.ViewModels.Admin.AdminEmployeeFormViewModel.EmployeeRoles)
                                {
                                    <option value="@role">@role</option>
                                }
                            </select>
                            <span asp-validation-for="Role" class="text-danger"></span>
                            <small class="text-muted">Changing role will generate a new employee code automatically.</small>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Username" class="form-label"></label>
                            <input asp-for="Username" class="form-control" />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label">New Password</label>
                            <input asp-for="Password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                            <input asp-for="ConfirmPassword" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Address1" class="form-label"></label>
                            <input asp-for="Address1" class="form-control" />
                            <span asp-validation-for="Address1" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Address2" class="form-label"></label>
                            <input asp-for="Address2" class="form-control" />
                            <span asp-validation-for="Address2" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Subdistrict" class="form-label"></label>
                            <input asp-for="Subdistrict" class="form-control" />
                            <span asp-validation-for="Subdistrict" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="District" class="form-label"></label>
                            <input asp-for="District" class="form-control" />
                            <span asp-validation-for="District" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Province" class="form-label"></label>
                            <input asp-for="Province" class="form-control" />
                            <span asp-validation-for="Province" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="PostalCode" class="form-label"></label>
                            <input asp-for="PostalCode" class="form-control" />
                            <span asp-validation-for="PostalCode" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="HireDate" class="form-label"></label>
                            <input asp-for="HireDate" class="form-control" />
                            <span asp-validation-for="HireDate" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="EmploymentStatus" class="form-label"></label>
                            <select asp-for="EmploymentStatus" class="form-select">
                                @foreach (var status in _66014444_Project.ViewModels.Admin.AdminEmployeeFormViewModel.EmploymentStatuses)
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                            <span asp-validation-for="EmploymentStatus" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ResignDate" class="form-label"></label>
                            <input asp-for="ResignDate" class="form-control" />
                            <span asp-validation-for="ResignDate" class="text-danger"></span>
                        </div>

                        <div class="col-12 pt-2 d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                            <a asp-action="EmployeeList" asp-controller="Admin" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
