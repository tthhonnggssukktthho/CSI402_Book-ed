@model IEnumerable<_66014444_Project.Models.Customer>
@{
    ViewData["Title"] = "Customer List";
    Layout = "_LayoutStaff";
}

<div class="container">
    <h2>Customer List</h2>
    <p>Here you can manage your customers.</p>

    <table class="table table-hover table-bordered">
        <thead>
            <tr>
                <th>Username</th>
                <th>Email</th>
                <th>Display Name</th>
                <th>Phone Number</th>
                <th>Status</th>
                <th>Current Points</th>
                <th>Created At</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var customer in Model)
            {
                <tr>
                    <td>@customer.User?.Username</td>
                    <td>@customer.User?.Email</td>
                    <td>@customer.DisplayName</td>
                    <td>@customer.User?.PhoneNumber</td>
                    <td>@customer.Status</td>
                    <td>@customer.CurrentPoints</td>
                    <td>@customer.CreatedAt</td>
                </tr>
            }
        </tbody>
    </table>
</div>
