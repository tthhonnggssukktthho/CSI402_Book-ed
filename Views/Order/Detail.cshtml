@model _66014444_Project.ViewModels.Order.OrderDetailViewModel
@{
    ViewData["Title"] = "Order Detail";
    Layout = "_Layout";
}

<section class="catalog-page">
    <div class="catalog-heading">
        <div>
            <p class="catalog-kicker">Order Detail</p>
            <h1>@Model.OrderNo</h1>
            <p class="catalog-subtitle">รายละเอียดคำสั่งซื้อและสถานะการดำเนินงาน</p>
        </div>
        <div class="catalog-summary">
            <strong><partial name="_OrderStatusBadge" model="Model.OrderStatus" /></strong>
            <span>สถานะปัจจุบัน</span>
        </div>
    </div>

    @if (TempData["OrderSuccess"] is string orderSuccess)
    {
        <div class="alert alert-success">@orderSuccess</div>
    }

    @if (TempData["OrderError"] is string orderError)
    {
        <div class="alert alert-danger">@orderError</div>
    }

    <div class="d-flex flex-column gap-4">
        <div class="filter-card">
            <h2>สถานะคำสั่งซื้อ</h2>
            <div class="row g-3">
                <div class="col-md-4">
                    <strong>การชำระเงิน</strong>
                    <div><partial name="_PaymentStatusBadge" model="Model.PaymentStatus" /></div>
                </div>
                <div class="col-md-4">
                    <strong>การอนุมัติ</strong>
                    <div><partial name="_OrderStatusBadge" model="Model.OrderStatus" /></div>
                </div>
                <div class="col-md-4">
                    <strong>การจัดส่ง</strong>
                    <div><partial name="_ShipmentStatusBadge" model="Model.ShipmentStatus" /></div>
                </div>
            </div>
        </div>

        <div class="filter-card">
            <h2>ที่อยู่จัดส่ง</h2>
            <div><strong>@Model.SnapReceiverName</strong></div>
            <div>@Model.SnapReceiverPhone</div>
            <div>@Model.SnapAddressLine1</div>
            @if (!string.IsNullOrWhiteSpace(Model.SnapAddressLine2))
            {
                <div>@Model.SnapAddressLine2</div>
            }
            <div>@Model.SnapSubdistrict @Model.SnapDistrict</div>
            <div>@Model.SnapProvince @Model.SnapPostalCode</div>
        </div>

        <div class="filter-card">
            <h2>รายการหนังสือ</h2>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>หนังสือ</th>
                            <th>สภาพ</th>
                            <th>ราคา</th>
                            <th>สุทธิ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@item.BookTitleSnapshot</div>
                                    <div class="small text-muted">@item.SeriesNameSnapshot</div>
                                </td>
                                <td>@item.ConditionCodeSnap</td>
                                <td>฿@item.UnitPrice.ToString("0.##")</td>
                                <td>฿@item.NetAmount.ToString("0.##")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="filter-card">
            <h2>สรุปยอดและหลักฐานการชำระเงิน</h2>
            <div class="d-flex justify-content-between mb-2"><span>ราคาสินค้ารวม</span><span>฿@Model.SubtotalAmount.ToString("0.##")</span></div>
            <div class="d-flex justify-content-between mb-2"><span>ส่วนลดตามสภาพ</span><span>- ฿@Model.ConditionDiscountAmount.ToString("0.##")</span></div>
            <div class="d-flex justify-content-between mb-2"><span>ส่วนลดโปรโมชัน</span><span>- ฿@Model.PromotionDiscountAmount.ToString("0.##")</span></div>
            <div class="d-flex justify-content-between mb-2"><span>ส่วนลดแต้มสะสม</span><span>- ฿@Model.PointsDiscountAmount.ToString("0.##")</span></div>
            <div class="d-flex justify-content-between mb-2"><span>ค่าจัดส่ง</span><span>฿@Model.ShippingFee.ToString("0.##")</span></div>
            <hr />
            <div class="d-flex justify-content-between mb-4"><strong>ยอดรวมทั้งหมด</strong><strong>฿@Model.TotalAmount.ToString("0.##")</strong></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <strong>ชื่อผู้โอน</strong>
                    <div>@(string.IsNullOrWhiteSpace(Model.PayerName) ? "-" : Model.PayerName)</div>
                </div>
                <div class="col-md-6">
                    <strong>เวลาโอน</strong>
                    <div>@(Model.TransferDatetime?.ToString("yyyy-MM-dd HH:mm") ?? "-")</div>
                </div>
                <div class="col-md-6">
                    <strong>จำนวนเงินที่โอน</strong>
                    <div>@(Model.TransferAmount.HasValue ? $"฿{Model.TransferAmount.Value:0.##}" : "-")</div>
                </div>
                <div class="col-md-6">
                    <strong>เลขติดตาม</strong>
                    <div>@(string.IsNullOrWhiteSpace(Model.TrackingNo) ? "-" : Model.TrackingNo)</div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.EvidenceUrl))
            {
                <div class="pt-3">
                    <a href="@Model.EvidenceUrl" target="_blank" class="book-card-button">ดูหลักฐานการชำระเงิน</a>
                </div>
            }

            @if (Model.CanUploadPayment)
            {
                <div class="pt-3">
                    <a asp-controller="Payment" asp-action="Upload" class="btn btn-outline-primary">อัปโหลดหลักฐานการชำระเงิน</a>
                </div>
            }
        </div>
        @if (Model.CanConfirmDelivery)
        {
            <div>
                <form asp-controller="Order" asp-action="ConfirmDelivered" asp-route-id="@Model.OrderId" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success" style="float: right;">ฉันได้รับสินค้าแล้ว</button>
                </form>
            </div>
        }
    </div>
</section>
