@model _66014444_Project.ViewModels.Finance.FinanceQueueViewModel
@{
    ViewData["Title"] = "คิวตรวจสอบการชำระเงิน";
    Layout = "_LayoutStaff";
}

<div class="container py-4">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h2 class="mb-1">คิวตรวจสอบออเดอร์</h2>
                    <p class="text-muted mb-0">รายการคำสั่งซื้อที่รอให้ฝ่ายการเงินตรวจสอบหลักฐานการชำระเงิน</p>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>เลขที่คำสั่งซื้อ</th>
                            <th>ลูกค้า</th>
                            <th>ยอดรวม</th>
                            <th>ยอดโอน</th>
                            <th>สถานะการชำระเงิน</th>
                            <th>หลักฐาน</th>
                            <th>เวลาส่งหลักฐาน</th>
                            <th>จัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Payments.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">ยังไม่มีรายการในคิวการเงิน</td>
                            </tr>
                        }

                        @foreach (var item in Model.Payments)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@item.OrderNo</div>
                                    <div class="small text-muted text-capitalize">@item.OrderStatus</div>
                                </td>
                                <td>@item.CustomerDisplayName</td>
                                <td>@item.TotalAmount.ToString("N2") บาท</td>
                                <td>@item.TransferAmount.ToString("N2") บาท</td>
                                <td>
                                    <span class="badge @(item.PaymentStatus == "approved" ? "bg-success" : item.PaymentStatus == "rejected" ? "bg-danger" : item.PaymentStatus == "submitted" ? "bg-primary" : "bg-secondary") text-capitalize">
                                        @item.PaymentStatus
                                    </span>
                                </td>
                                <td>
                                    @if (item.HasEvidence)
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis">มีไฟล์แนบ</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">ไม่มี</span>
                                    }
                                </td>
                                <td>@(item.EvidenceUploadedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                <td>
                                    <a asp-controller="Finance" asp-action="OrderDetail" asp-route-id="@item.PaymentId" class="btn btn-outline-primary btn-sm">ดูรายละเอียด</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
