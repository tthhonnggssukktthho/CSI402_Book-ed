@model _66014444_Project.ViewModels.Finance.FinancePaymentDetailViewModel
@{
    ViewData["Title"] = "รายละเอียดออเดอร์";
    Layout = "_LayoutStaff";
}

<div class="container py-4">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-lg-5">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
                <div>
                    <h2 class="mb-1">รายละเอียดคำสั่งซื้อสำหรับตรวจสอบการชำระเงิน</h2>
                    <p class="text-muted mb-0">@Model.OrderNo</p>
                </div>
                <a asp-controller="Finance" asp-action="Queue" class="btn btn-outline-secondary">กลับไปคิวการเงิน</a>
            </div>

            @if (TempData["FinanceSuccess"] is string successMessage)
            {
                <div class="alert alert-success">@successMessage</div>
            }

            @if (TempData["FinanceError"] is string errorMessage)
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <div class="border rounded-3 p-3 h-100 bg-light">
                        <small class="text-muted d-block">สถานะการชำระเงิน</small>
                        <strong class="text-capitalize">@Model.PaymentStatus</strong>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded-3 p-3 h-100 bg-light">
                        <small class="text-muted d-block">สถานะออเดอร์</small>
                        <strong class="text-capitalize">@Model.OrderStatus</strong>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded-3 p-3 h-100 bg-light">
                        <small class="text-muted d-block">สถานะการจัดส่ง</small>
                        <strong class="text-capitalize">@Model.ShipmentStatus</strong>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="mb-4">
                        <h4 class="mb-3">รายการหนังสือในออเดอร์</h4>
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>หนังสือ</th>
                                        <th>สภาพ</th>
                                        <th>ราคา</th>
                                        <th>สุทธิ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@item.BookTitleSnapshot</div>
                                                <div class="small text-muted">@item.SeriesNameSnapshot</div>
                                            </td>
                                            <td>@item.ConditionCodeSnap</td>
                                            <td>@item.UnitPrice.ToString("N2") บาท</td>
                                            <td>@item.NetAmount.ToString("N2") บาท</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div>
                        <h4 class="mb-3">หลักฐานการชำระเงิน</h4>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <strong>ชื่อผู้โอน</strong>
                                <div>@(string.IsNullOrWhiteSpace(Model.PayerName) ? "-" : Model.PayerName)</div>
                            </div>
                            <div class="col-md-6">
                                <strong>วันเวลาที่โอน</strong>
                                <div>@(Model.TransferDatetime?.ToString("yyyy-MM-dd HH:mm") ?? "-")</div>
                            </div>
                            <div class="col-md-6">
                                <strong>จำนวนเงินที่โอน</strong>
                                <div>@Model.TransferAmount.ToString("N2") บาท</div>
                            </div>
                            <div class="col-md-6">
                                <strong>อัปโหลดหลักฐานเมื่อ</strong>
                                <div>@(Model.EvidenceUploadedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</div>
                            </div>
                            <div class="col-12">
                                @if (Model.HasEvidence)
                                {
                                    <a href="@Model.EvidenceUrl" target="_blank" class="book-card-button">ดูหลักฐานการชำระเงิน</a>
                                }
                                else
                                {
                                    <span class="text-muted">ยังไม่มีไฟล์หลักฐาน</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="border rounded-3 p-4 bg-light h-100">
                        <h4 class="mb-3">สรุปยอดและผลการตรวจสอบ</h4>
                        <div class="d-flex justify-content-between mb-2">
                            <span>ลูกค้า</span>
                            <strong>@Model.CustomerDisplayName</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>ราคาสินค้ารวม</span>
                            <strong>@Model.SubtotalAmount.ToString("N2") บาท</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>ค่าจัดส่ง</span>
                            <strong>@Model.ShippingFee.ToString("N2") บาท</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span>ยอดรวมทั้งหมด</span>
                            <strong>@Model.TotalAmount.ToString("N2") บาท</strong>
                        </div>

                        <hr />

                        <div class="mb-3">
                            <strong>ที่อยู่จัดส่ง</strong>
                            <div class="mt-2">@Model.SnapReceiverName</div>
                            <div>@Model.SnapReceiverPhone</div>
                            <div>@Model.SnapAddressLine1</div>
                            @if (!string.IsNullOrWhiteSpace(Model.SnapAddressLine2))
                            {
                                <div>@Model.SnapAddressLine2</div>
                            }
                            <div>@Model.SnapSubdistrict @Model.SnapDistrict</div>
                            <div>@Model.SnapProvince @Model.SnapPostalCode</div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.RejectReason))
                        {
                            <div class="alert alert-warning">
                                <strong>เหตุผลที่ไม่อนุมัติล่าสุด:</strong> @Model.RejectReason
                            </div>
                        }

                        @if (Model.VerifiedAt is not null)
                        {
                            <div class="alert alert-secondary mb-3">
                                <div><strong>ตรวจสอบแล้วโดย:</strong> @(Model.VerifiedByName ?? "-")</div>
                                <div><strong>เมื่อ:</strong> @Model.VerifiedAt?.ToString("yyyy-MM-dd HH:mm")</div>
                            </div>
                        }

                        @if (Model.CanTakeAction)
                        {
                            <div class="d-flex gap-2 flex-wrap">
                                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#approvePaymentModal">อนุมัติ</button>
                                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectPaymentModal">ไม่อนุมัติ</button>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-light border mb-0">
                                รายการนี้ถูกตรวจสอบแล้ว ไม่สามารถเปลี่ยนผลการอนุมัติจากหน้านี้ได้
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="modal fade" id="approvePaymentModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">ยืนยันการอนุมัติ</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            คุณต้องการอนุมัติหลักฐานการชำระเงินของคำสั่งซื้อ <strong>@Model.OrderNo</strong> ใช่หรือไม่
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                            <form asp-controller="Finance" asp-action="ApprovePayment" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="paymentId" value="@Model.PaymentId" />
                                <button type="submit" class="btn btn-success">ยืนยันการอนุมัติ</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="rejectPaymentModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">ยืนยันการไม่อนุมัติ</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <form asp-controller="Finance" asp-action="RejectPayment" method="post">
                            @Html.AntiForgeryToken()
                            <div class="modal-body">
                                <input type="hidden" name="paymentId" value="@Model.PaymentId" />
                                <label for="rejectReason" class="form-label">เหตุผลที่ไม่อนุมัติ</label>
                                <textarea id="rejectReason" name="rejectReason" class="form-control" rows="4" required>@Model.RejectReason</textarea>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                                <button type="submit" class="btn btn-danger">ยืนยันการไม่อนุมัติ</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
