@model _66014444_Project.ViewModels.Finance.PromotionIndexViewModel
@{
    ViewData["Title"] = "จัดการโปรโมชัน";
    Layout = "_LayoutStaff";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <h2 class="mb-1">จัดการโปรโมชัน</h2>
            <p class="text-muted mb-0">รวมโปรโมชันอัตโนมัติของระบบ และ Flash Sale ที่ฝ่ายการเงินสร้างได้เอง</p>
        </div>
        <a asp-controller="Promotion" asp-action="Create" class="btn btn-primary">สร้างโปรโมชัน</a>
    </div>

    @if (TempData["PromotionSuccess"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }

    <div class="row g-4 mb-4">
        @foreach (var item in Model.SystemPromotions)
        {
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <span class="badge bg-info-subtle text-info-emphasis mb-3">อัตโนมัติ</span>
                        <h5 class="card-title">@item.Title</h5>
                        <p class="text-muted mb-2">@item.Description</p>
                        <p class="mb-2">@item.Detail</p>
                        <small class="text-success">@item.AutoApplyNote</small>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h4 class="mb-1">Flash Sale</h4>
                    <p class="text-muted mb-0">โปรโมชันช่วงเวลาจำกัดตามชุดนิยายที่เลือก</p>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>โค้ด</th>
                            <th>ชื่อโปรโมชัน</th>
                            <th>ชุดนิยาย</th>
                            <th>ส่วนลด</th>
                            <th>ช่วงเวลา</th>
                            <th>สถานะ</th>
                            <th>จัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Promotions.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">ยังไม่มี Flash Sale ในระบบ</td>
                            </tr>
                        }

                        @foreach (var item in Model.Promotions)
                        {
                            <tr>
                                <td>@item.PromotionCode</td>
                                <td>@item.PromotionName</td>
                                <td>@item.TargetSeriesName</td>
                                <td>
                                    @if (item.DiscountType == "percent")
                                    {
                                        <span>@item.DiscountValue?.ToString("0.##")%</span>
                                    }
                                    else
                                    {
                                        <span>@item.DiscountValue?.ToString("N2") บาท</span>
                                    }
                                </td>
                                <td>
                                    <div>@item.StartAt.ToString("yyyy-MM-dd HH:mm")</div>
                                    <div class="small text-muted">ถึง @(item.EndAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</div>
                                </td>
                                <td>
                                    <span class="badge @(item.IsActive && !item.IsExpired ? "bg-success" : item.IsExpired ? "bg-secondary" : "bg-warning text-dark")">
                                        @(item.IsActive && !item.IsExpired ? "กำลังใช้งาน" : item.IsExpired ? "หมดเวลาแล้ว" : "ปิดใช้งาน")
                                    </span>
                                </td>
                                <td>
                                    <a asp-controller="Promotion" asp-action="Edit" asp-route-id="@item.PromotionId" class="btn btn-outline-primary btn-sm">แก้ไข</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
